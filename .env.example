# Copy this file to .env for local use only. Never commit a real .env file.
# Postgres connection string from Neon.
DATABASE_URL=postgresql://user:password@host/database?sslmode=require
# Owner moderation secret. Pick a long random value. No default is used.
OWNER_SECRET=replace_with_a_long_random_secret
# Port the app listens on locally. Render sets this itself when deployed.
PORT=3000
